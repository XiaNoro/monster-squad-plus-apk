; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Monster Squad+"
config/description="Offline single-player revival of Nexon's Monster Squad (2014)."
config/version="0.6.1"
run/main_scene="res://scenes/main.tscn"
config/quit_on_go_back=false
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://assets/logo.png"

[autoload]

DB="*res://scripts/autoload/game_data.gd"
Save="*res://scripts/autoload/save_game.gd"
Sfx="*res://scripts/autoload/audio.gd"

[display]

window/size/viewport_width=1066
window/size/viewport_height=640
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
